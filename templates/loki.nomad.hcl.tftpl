job "${job_name}" {
  namespace   = "${namespace}"
  datacenters = ${jsonencode(datacenters)}
  type        = "service"

  meta {
    backup = "stop"
  }

  group "loki" {
    network {
      mode = "bridge"

      port "http" {
        static       = ${http_port}
        to           = ${http_port}
        host_network = "${internal_network}"
      }

      port "grpc" {
        static       = ${grpc_port}
        to           = ${grpc_port}
        host_network = "${internal_network}"
      }
%{ if mesh.enabled ~}

      # Envoy's metrics, scraped by the platform's Alloy for Consul's topology.
      port "envoy_metrics" {
        to           = 9102
        host_network = "${internal_network}"
      }
%{ endif ~}
    }

    volume "data" {
      type            = "host"
      source          = "${volume_name}"
      access_mode     = "single-node-writer"
      attachment_mode = "file-system"
    }

    service {
      name     = "${job_name}"
      port     = "http"
      provider = "consul"
%{ if mesh.enabled ~}

      # In the mesh: an Envoy sidecar (transparent proxy), so mesh services (the
      # dashboards) reach Loki as ${job_name}.virtual.consul, over mTLS, as the
      # intentions allow. The HTTP port stays open as well: the platform's Alloy
      # pushes the logs to it from the host, outside the mesh.
      connect {
        sidecar_service {
          # Its own tags: the sidecar takes the service's otherwise.
          tags = ["mesh-sidecar"]

          proxy {
            transparent_proxy {
              # Envoy runs as uid 1337, which no app uses: the transparent proxy
              # lets Envoy's own uid out unredirected.
              uid                   = "1337"
              no_dns                = true
              exclude_inbound_ports = ${jsonencode(concat([for p in mesh.keep_open_ports : tostring(p)], [tostring(http_port), "9102"]))}
            }
            config {
              envoy_prometheus_bind_addr = "0.0.0.0:9102"
            }
          }
        }

        sidecar_task {
          env {
            ENVOY_UID = "1337"
          }

          resources {
            cpu        = 50
            memory     = 32
            memory_max = 128
          }
        }
      }
%{ endif ~}

      check {
        type     = "http"
        path     = "/ready"
        interval = "15s"
        timeout  = "5s"
      }
    }
%{ if mesh.enabled ~}

    service {
      name     = "${job_name}-envoy"
      port     = "envoy_metrics"
      provider = "consul"
      tags     = ["metrics"]
    }
%{ endif ~}

    task "loki" {
      driver = "docker"

      config {
        image    = "${image}"
        args     = ["-config.file=/local/loki.yml"]
        cap_drop = ["all"]
      }

      volume_mount {
        volume      = "data"
        destination = "/loki"
      }

      template {
        destination = "local/loki.yml"
        data        = <<-LOKICONF
${config}
        LOKICONF
      }

      resources {
        cpu        = ${resources.cpu}
        memory     = ${resources.memory}
        memory_max = ${resources.memory_max}
      }
    }
  }
}
